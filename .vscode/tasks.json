{
  "version": "2.0.0",
  "tasks": [
    { "label": "setup", "type": "shell", "command": "scripts/agent-setup.sh", "windows": { "command": "powershell -File scripts/agent-setup.ps1" }, "problemMatcher": [] },
    { "label": "test", "type": "shell", "command": "pnpm test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
    { "label": "verify", "type": "shell", "command": "pnpm verify", "group": { "kind": "build", "isDefault": true }, "problemMatcher": [] },
    { "label": "lint", "type": "shell", "command": "pnpm lint", "problemMatcher": [] },
    { "label": "typecheck", "type": "shell", "command": "pnpm typecheck", "problemMatcher": [] },
    { "label": "format", "type": "shell", "command": "pnpm format", "problemMatcher": [] },
    { "label": "preview", "type": "shell", "command": "pnpm preview", "problemMatcher": [] },
    { "label": "dev", "type": "shell", "command": "pnpm dev", "isBackground": true, "problemMatcher": { "pattern": { "regexp": "^(ERROR) (.*)$", "severity": 1, "message": 2 }, "background": { "activesBegin": ".", "beginsPattern": "^INFO", "endsPattern": "^INFO" } } }
  ]
}
