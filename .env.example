# Copy to .env for `pnpm dev` and the "OLED: live" debug config. Never commit .env.
#
# HA_URL must be https (for example your Homeway or other remote-access URL),
# or http://localhost through an SSH tunnel:
#   ssh -L 8123:localhost:8123 <user>@homeassistant.local
# Plain http to another machine is refused, because the token would cross the
# network in clear text.
HA_URL=http://localhost:8123
# Keep the token out of files: store it in Proton Pass and put a pass:// reference
# here, then run through `pass-cli run --env-file .env -- pnpm dev`.
HA_TOKEN=pass://<vault>/<item>/token
